# ─────────────────────────────────────────────────────────────
# OmniSecretary — шаблон окружения.
# Скопируйте в .env (scripts/bootstrap-pi.sh делает это сам и
# генерирует секреты). НИКОГДА не коммитьте .env в git.
# ─────────────────────────────────────────────────────────────

# ── Общее ────────────────────────────────────────────────────
# Часовой пояс контейнеров (например Europe/Moscow).
TZ=Europe/Moscow

# Базовый каталог данных: тома сервисов, бэкапы, docker data-root.
# Внешний диск: /mnt/data/omnisecretary
# Без внешнего диска (SD-карта): /srv/omnisecretary
DATA_ROOT=/srv/omnisecretary

# Публичный адрес веб-интерфейса (LAN или домен через HTTPS).
# Используется Open WebUI для ссылок и CORS.
WEBUI_URL=http://192.168.0.133

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=openwebui
POSTGRES_USER=openwebui
# Сгенерировать: openssl rand -hex 24
# Пароль должен быть URL-безопасным (hex/base64url), т.к. попадает в DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME_HEX

# ── Секреты приложения ───────────────────────────────────────
# Сгенерировать: openssl rand -hex 32
WEBUI_SECRET_KEY=CHANGE_ME_HEX
# Пароль Redis (генерируется bootstrap): веб-сокеты и кэш сессий.
REDIS_PASSWORD=
# CORS: только свой домен и LAN, без «*».
CORS_ALLOW_ORIGIN="https://nedoletoff.sknt.ru;http://192.168.0.133"
# Срок жизни токена Open WebUI в секундах (30 дней).
JWT_EXPIRES_IN=2592000
# API-ключ Qdrant (внутренняя сеть + localhost:6333)
# Сгенерировать: openssl rand -hex 24
QDRANT_API_KEY=CHANGE_ME_HEX
# Секрет подписи сессий Vikunja (задачи)
# Сгенерировать: openssl rand -hex 32
VIKUNJA_SECRET=CHANGE_ME_HEX

# ── Vikunja (задачи) ─────────────────────────────────────────
# Внешний адрес Vikunja. Порт 8081 публикует nginx (только LAN).
VIKUNJA_PUBLIC_URL=http://192.168.0.133:8081/
# Логин администратора Vikunja создаётся скриптом scripts/init-vikunja.sh.
VIKUNJA_ADMIN_USERNAME=admin
VIKUNJA_ADMIN_EMAIL=admin@omnisecretary.local

# ── Основная LLM (OpenAI-совместимый облачный API) ───────────
# Бесплатный вариант для тестов (без ключа): Pollinations.
#   OPENAI_API_BASE_URL=https://text.pollinations.ai/openai
#   OPENAI_API_KEY=pollinations
# Модель для пресетов: openai-fast (gpt-oss-20b).
# Продакшн: OpenRouter, DeepSeek, Groq, Together — любой OpenAI-совместимый API.
OPENAI_API_BASE_URL=https://text.pollinations.ai/openai
OPENAI_API_KEY=pollinations
# Базовая модель пресетов. Пусто — скрипт выберет первую из /api/models.
PRESET_BASE_MODEL=openai-fast

# ── Портал: регистрация и личные настройки ───────────────────
# Секрет подписи сессий портала. Обязателен, ≥32 символа:
# без него портал не стартует (openssl rand -hex 32).
PORTAL_SECRET=
# Токен приглашения для регистрации. Пусто = TELEGRAM_CONFIRM_CODE.
REGISTER_TOKEN=

# ── Язык интерфейса по умолчанию ─────────────────────────────
# Не жёсткая настройка: каждый пользователь может сменить в Settings → Interface.
DEFAULT_LOCALE=ru-RU
# Модели, видимые пользователям по умолчанию (первая — основная).
DEFAULT_MODELS=omnisecretary,secretary,omni,archivist,coder,private

# ── Владелец Open WebUI (создаётся scripts/init-webui.sh) ────
# Пусто — email/пароль сгенерируются, пароль ляжет в
# ${DATA_ROOT}/secrets/webui-owner.txt (права 600).
# Логин владельца (почта не используется).
WEBUI_ADMIN_EMAIL=nedoletoff
WEBUI_ADMIN_PASSWORD=
WEBUI_ADMIN_NAME=Owner
# API-ключи нужны скриптам (импорт пресетов, бэкапы, бот).
ENABLE_API_KEYS=true

# ── Эмбеддинги для RAG/памяти (облако) ───────────────────────
# Можно указать тот же провайдер, что и для LLM, но модель эмбеддингов.
EMBEDDING_API_BASE_URL=https://api.example.com/v1
EMBEDDING_API_KEY=CHANGE_ME
EMBEDDING_MODEL=text-embedding-3-small

# ── Этап 2+: Telegram ────────────────────────────────────────
# Токен от @BotFather. Публичный бот запрещён, доступ только по allowlist.
TELEGRAM_BOT_TOKEN=
# Если api.telegram.org заблокирован: URL прокси (см. docs/telegram.md).
TELEGRAM_API_BASE=https://api.telegram.org
# Разрешённые Telegram user ID через запятую (числа).
TELEGRAM_ALLOWED_IDS=
# Ваш Telegram ID: бот работает под вашим аккаунтом Open WebUI,
# поэтому чаты из веба и Telegram — одни и те же.
TELEGRAM_OWNER_ID=
# Необязательно: соответствие «TG ID:email аккаунта Open WebUI».
# Остальные разрешённые ID получают отдельный аккаунт tg<id>@omnisecretary.local.
TELEGRAM_ACCOUNT_MAP=
TELEGRAM_DEFAULT_MODEL=omnisecretary
# Открытый вход по коду подтверждения (allowlist остаётся пустым).
TELEGRAM_OPEN_ACCESS=false
# 16 символов; выдавать только своим. Хранить в secrets, не в git.
TELEGRAM_CONFIRM_CODE=
# Адрес веб-интерфейса для кнопки /app. HTTPS → Mini App, HTTP → браузер.
PUBLIC_URL=https://nedoletoff.sknt.ru

# ── Obsidian-вольт (этап 4) ──────────────────────────────────
# Вольт подключается через веб-форму: http://<ip>/vault/ (Basic Auth).
# Токен git хранится в ${DATA_ROOT}/secrets/vault-git-token, не здесь.
# VAULT_ADMIN_PASSWORD генерируется bootstrap; логин — VAULT_ADMIN_USER.
VAULT_ADMIN_USER=owner
VAULT_ADMIN_PASSWORD=
# Ветка вольта и папка, куда ассистенту разрешена запись.
VAULT_BRANCH=main
VAULT_WRITE_PREFIX=AI
# Push после каждой записи. false — коммиты остаются локальными.
VAULT_PUSH_ENABLED=true

# ── GitHub MCP ───────────────────────────────────────────────
# Fine-grained PAT: Contents read/write, Issues, Pull requests (только нужные репозитории).
GITHUB_TOKEN=
# Запись (файлы, issues, PR) по умолчанию выключена: только чтение.
# Включать осознанно, когда ассистенту действительно нужно писать.
GITHUB_WRITE_ENABLED=false

# ── VPN (зарубежный трафик через прокси) ─────────────────────
# Ссылка-подписка VLESS из приложения провайдера (Happ и т.п.).
# Секрет: не коммитить. Конфиг генерирует scripts/vpn-config.py.
VPN_KEY=
# Принудительный выбор сервера по точному имени из подписки (опционально).
# VPN_SERVER=

# ── Vikunja MCP ──────────────────────────────────────────────
# Создаётся scripts/init-vikunja.sh и хранится также в secrets.
VIKUNJA_API_TOKEN=

# ── Проактивность (этап 6) ───────────────────────────────────
# Утренний брифинг: погода, календарь, задачи, заметки → Telegram.
# Значение по умолчанию; в боте меняется командой /briefing 08:00.
BRIEFING_TIME=07:30
# Координаты для погоды (api.met.no). Пример — Москва.
WEATHER_LAT=59.8772
WEATHER_LON=30.4413
WEATHER_CITY="Санкт-Петербург, Ломоносовская"

# ── Голос (этап 5) ───────────────────────────────────────────
# STT (sherpa-onnx + модель Vosk) и TTS (Silero, альтернатива Piper) —
# отдельные контейнеры, профиль voice. Подробно — docs/voice.md.
AUDIO_STT_ENGINE=openai
AUDIO_TTS_ENGINE=openai
# Голос Silero: aidar, baya, kseniya, xenia, eugene.
TTS_DEFAULT_VOICE=baya
# Для Piper вместо Silero:
# AUDIO_TTS_OPENAI_API_BASE_URL=http://tts-piper:8000/v1

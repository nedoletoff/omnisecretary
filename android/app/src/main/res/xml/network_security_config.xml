<?xml version="1.0" encoding="utf-8"?>
<!-- Только HTTPS: открытый HTTP к серверу запрещён на уровне системы. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

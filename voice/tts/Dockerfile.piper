# Piper TTS — лёгкая альтернатива Silero (onnxruntime, ~60 МБ ОЗУ).
# Тот же app.py, другой backend: TTS_BACKEND=piper.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TTS_BACKEND=piper \
    PIPER_MODEL_PATH=/models/ru_RU-irina-medium.onnx \
    TTS_MAX_CHARS=1000

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates libgomp1 \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
      "piper-tts==1.3.0" \
      "fastapi==0.121.0" \
      "uvicorn[standard]==0.38.0"

# Голос irina (medium) + конфиг из репозитория rhasspy/piper-voices.
ARG PIPER_BASE=https://huggingface.co/rhasspy/piper-voices/resolve/main/ru/ru_RU/irina/medium
RUN mkdir -p /models \
 && curl -fsSL "$PIPER_BASE/ru_RU-irina-medium.onnx" -o /models/ru_RU-irina-medium.onnx \
 && curl -fsSL "$PIPER_BASE/ru_RU-irina-medium.onnx.json" -o /models/ru_RU-irina-medium.onnx.json \
 && test -s /models/ru_RU-irina-medium.onnx

COPY app.py /app/app.py
WORKDIR /app

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/healthz',timeout=3)"

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
